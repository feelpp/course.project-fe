{
    "latex-workshop.latex.outDir": "%DIR%/output/pdf",
    "latex-workshop.latex.recipe.default": "latexmk-pdf",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk-pdf",
            "tools": [
                "latexmk-pdf"
            ]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-pdf",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-halt-on-error",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ],
            "cwd": "%DIR%"
        }
    ],
    "latex-workshop.latex.autoBuild.run": "onFileChange"
}
